# Secret used to sign one-click pulse links embedded in the Tuesday Tape Drop
# email. Any long random string. Links are HMAC-signed so answering from the
# email needs no login.
NB_LINK_SECRET=change-me-long-random-string

# Key that unlocks /admin. Visit /admin and paste it once; stored in a cookie.
NB_ADMIN_KEY=change-me-admin-key

# Base URL used when composing emails (one-click links point here).
NB_BASE_URL=http://localhost:3000

# Resend API key. When unset, the Tuesday Tape Drop is written to
# data/outbox/*.html instead of being sent — preview mode.
RESEND_API_KEY=

# Where the runtime JSON database lives. Defaults to ./data locally and
# /tmp/nomad-benchmark on serverless. Point at a persistent disk in prod.
NB_DATA_DIR=
