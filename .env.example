# Optional: comma-separated Greenhouse board tokens to watch specific companies,
# e.g. RN_GREENHOUSE_BOARDS=stripe,figma
RN_GREENHOUSE_BOARDS=

# Optional: override where the JSON job database is stored (defaults to ./data,
# or /tmp/revenue-nomad on serverless platforms)
# RN_DATA_DIR=/var/lib/revenue-nomad

# Optional: protect GET /api/crawl (used by Vercel Cron / scheduled pingers).
# When set, scheduled requests must send "Authorization: Bearer <secret>".
# CRON_SECRET=change-me

# Trading Post: comma-separated member emails who can review reported values.
# While email sign-in is off, an admin address can't be claimed in the join form. Use a
# member's address, or join once with the header "x-cron-secret: <RN_CRON_SECRET>".
# RN_ADMIN_EMAILS=you@example.com
# Optional: explicit path to the private member seed (defaults to RN_DATA_DIR/intel-seed.json).
# RN_INTEL_SEED=/var/data/intel-seed.json
# Opens data/intel-seed.enc, the encrypted member seed (the contents of data/intel-seed.key).
# RN_INTEL_SEED_KEY=
# RN_REQUIRE_SEED=1 never runs on the sample data: if the seed does not open, every route answers
# 503 and GET /api/health fails, so a deploy with a missing key never goes live. The Dockerfile sets it.
# RN_REQUIRE_SEED=1
# Signs the public ids the app sees and the unsubscribe links. Set it to the seed key's current
# value once, then keep it when the seed key changes, so no id or link already sent changes.
# RN_ID_SECRET=

# Trading Post: where members can write to you. Read when the server runs (not at build time),
# so the sign-in screens, "Questions and feedback" and "Ask for an intro" show them (View.contact).
# Without RN_SUPPORT_EMAIL a member who lost their link is told to ask the member who invited them.
# Without RN_INTRO_EMAIL an unlocked seat holder offers "Find them on LinkedIn" only.
# RN_SUPPORT_EMAIL=help@example.com
# RN_INTRO_EMAIL=intros@example.com

# Trading Post: the client address used by the rate limits and the invite rule. By default the
# rightmost X-Forwarded-For entry. Set RN_CLIENT_IP_HEADER to a header the host overwrites
# (e.g. true-client-ip), or RN_TRUSTED_PROXY_HOPS to the number of proxies that append to
# X-Forwarded-For. RN_LOG_IP_HEADERS=1 logs the candidate headers for the first 20 requests:
# send one request with a forged "X-Forwarded-For: 1.2.3.4", read the log, then remove it.
# RN_CLIENT_IP_HEADER=true-client-ip
# RN_TRUSTED_PROXY_HOPS=1
# RN_LOG_IP_HEADERS=1

# Trading Post: health. GET /api/health answers 200 only when the seed opened, the state loaded
# and RN_DATA_DIR takes writes, else 503 naming the part that failed. Point the host's health
# check at it (railway.json does). Nothing to set.

# Trading Post: off-site copy of the daily backup, to an S3-compatible bucket (all four needed).
# RN_BACKUP_S3_ENDPOINT=https://storage.railway.app
# RN_BACKUP_S3_BUCKET=
# RN_BACKUP_S3_KEY_ID=
# RN_BACKUP_S3_SECRET=
# RN_BACKUP_S3_REGION=auto
# RN_BACKUP_S3_PATH_STYLE=1
# RN_LOGO_LOOKUP=off stops the background lookup of company logos by name.
# RN_LOGO_LOOKUP=off

# Trading Post: credits a new member starts with (default 25).
# RN_STARTER_CREDITS=25

# Trading Post: the weekly scan of open fractional GTM roles.
# RN_SCAN=1 starts a scan in the background when the last one is over 7 days old.
# RN_SCAN=1
# Or point a weekly cron at POST /api/table/scan with the header "x-cron-secret: <secret>".
# The endpoint is off until this is set.
# RN_CRON_SECRET=change-me
# Tests only, never in production: RN_SCAN_TEST=1 makes the scan endpoint store the roles the
# request sends instead of reading the job boards.
# RN_SCAN_TEST=1

# Trading Post: email (sign-in links and the weekly email of new open roles).
# RESEND_API_KEY=
# RN_EMAIL_FROM="Trading Post <post@example.com>"
# Links in emails point here.
# RN_PUBLIC_URL=https://post.example.com
# RN_DIGEST=0 keeps the weekly email off while sign-in emails stay on.
# RN_DIGEST=0
# The weekly email goes to members who have signed in. RN_DIGEST_ALL=1 sends it to every member on file.
# RN_DIGEST_ALL=1
# One line for the weekly email's footer, such as the sender's postal address.
# RN_EMAIL_FOOTER=
