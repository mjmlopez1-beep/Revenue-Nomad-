# Optional: comma-separated Greenhouse board tokens to watch specific companies,
# e.g. RN_GREENHOUSE_BOARDS=stripe,figma
RN_GREENHOUSE_BOARDS=

# Optional: override where the JSON job database is stored (defaults to ./data,
# or /tmp/revenue-nomad on serverless platforms)
# RN_DATA_DIR=/var/lib/revenue-nomad

# Optional: protect GET /api/crawl (used by Vercel Cron / scheduled pingers).
# When set, scheduled requests must send "Authorization: Bearer <secret>".
# CRON_SECRET=change-me
