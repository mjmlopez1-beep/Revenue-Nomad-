# Optional: comma-separated Greenhouse board tokens to watch specific companies,
# e.g. RN_GREENHOUSE_BOARDS=stripe,figma
RN_GREENHOUSE_BOARDS=

# Optional: override where the JSON job database is stored (defaults to ./data,
# or /tmp/revenue-nomad on serverless platforms)
# RN_DATA_DIR=/var/lib/revenue-nomad

# Optional: protect GET /api/crawl (used by Vercel Cron / scheduled pingers).
# When set, scheduled requests must send "Authorization: Bearer <secret>".
# CRON_SECRET=change-me

# The Table (/table): comma-separated member emails who can review reported values.
# While email sign-in is off, an admin address can't be claimed in the join form. Use a
# member's address, or join once with the header "x-cron-secret: <RN_CRON_SECRET>".
# RN_ADMIN_EMAILS=you@example.com
# Optional: explicit path to the private member seed (defaults to RN_DATA_DIR/intel-seed.json).
# RN_INTEL_SEED=/var/data/intel-seed.json

# Trading Post: credits a new member starts with (default 25).
# RN_STARTER_CREDITS=25

# Trading Post: the weekly scan of open fractional GTM roles.
# RN_SCAN=1 starts a scan in the background when the last one is over 7 days old.
# RN_SCAN=1
# Or point a weekly cron at POST /api/table/scan with the header "x-cron-secret: <secret>".
# The endpoint is off until this is set.
# RN_CRON_SECRET=change-me

# Trading Post: email (sign-in links and the weekly email of new open roles).
# RESEND_API_KEY=
# RN_EMAIL_FROM="Trading Post <post@example.com>"
# Links in emails point here.
# RN_PUBLIC_URL=https://post.example.com
# RN_DIGEST=0 keeps the weekly email off while sign-in emails stay on.
# RN_DIGEST=0
# The weekly email goes to members who have signed in. RN_DIGEST_ALL=1 sends it to every member on file.
# RN_DIGEST_ALL=1
# One line for the weekly email's footer, such as the sender's postal address.
# RN_EMAIL_FOOTER=
