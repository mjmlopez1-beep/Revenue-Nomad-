# Optional: comma-separated Greenhouse board tokens to watch specific companies,
# e.g. RN_GREENHOUSE_BOARDS=stripe,figma
RN_GREENHOUSE_BOARDS=

# Optional: override where the JSON job database is stored (defaults to ./data,
# or /tmp/revenue-nomad on serverless platforms)
# RN_DATA_DIR=/var/lib/revenue-nomad

# Optional: protect GET /api/crawl (used by Vercel Cron / scheduled pingers).
# When set, scheduled requests must send "Authorization: Bearer <secret>".
# CRON_SECRET=change-me

# Revenue Health Check leads. Portal ID is public configuration; the form ID comes from the HubSpot form
# named "Revenue health check". When either is unset, leads are appended to <RN_DATA_DIR>/checks.json.
HUBSPOT_PORTAL_ID=48733774
# HUBSPOT_CHECK_FORM_ID=

# Talk to us requests go to the HubSpot form named "Talk to us"; unset = <RN_DATA_DIR>/talk-requests.json.
# HUBSPOT_TALK_FORM_ID=
# Buyer's Guide readers (chapter gate and the homepage form) go to the HubSpot form named
# "Fractional GTM Buyer's Guide 2027"; unset = <RN_DATA_DIR>/guide-requests.json.
# HUBSPOT_GUIDE_FORM_ID=
# Public booking page for "Rather talk now?" and "Book a call". Defaults to https://calendly.com/revenuenomad;
# set to an empty string to hide the cards.
# NEXT_PUBLIC_BOOK_CALL_URL=https://calendly.com/revenuenomad
